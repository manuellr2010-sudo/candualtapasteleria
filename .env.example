# ─────────────────────────────────────────────────────────────
# Candú · Variables de entorno (copia este archivo a .env.local)
# Los secretos SOLO van en el servidor. Nunca los subas a git.
# Si una integración no tiene sus variables, la web la muestra
# como "no conectada" y no la ofrece a los clientes.
# ─────────────────────────────────────────────────────────────

# URL pública de la web (sin barra final). En local: http://localhost:3000
PUBLIC_BASE_URL=http://localhost:3000

# Carpeta de datos (base de datos SQLite y archivos subidos). En Vercel no se usa: el disco no es persistente.
DATA_DIR=./data
# Base de datos libSQL remota (Turso). OBLIGATORIA en Vercel para que los datos no se pierdan.
# La integración de Turso del Marketplace de Vercel crea TURSO_DATABASE_URL y TURSO_AUTH_TOKEN; también valen estos nombres:
DATABASE_URL=
DATABASE_AUTH_TOKEN=
# TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN=

# ── Archivos en Vercel Blob (almacén PRIVADO) ─────────────────
# Lo crea Vercel al conectar un almacén Blob al proyecto. Sin él, en local se usa data/uploads.
BLOB_READ_WRITE_TOKEN=
# "private" (recomendado, por defecto) o "public"
BLOB_ACCESS=private

# ── Vista previa y lanzamiento ───────────────────────────────
# Dónde se configuran en Vercel: proyecto › Settings › Environment Variables (Preview / Production). Ver docs/VERCEL.md
# 1 = marcar como vista previa (noindex + aviso) aunque no sea Vercel Preview
PREVIEW_MODE=
# Cobros reales BLOQUEADOS salvo que el propietario lo autorice con 1 (nunca se permiten en vistas previas)
ALLOW_LIVE_PAYMENTS=

# ── Acceso al panel ──────────────────────────────────────────
# Genera ambos valores con:  npm run admin:password
# No hay contraseña por defecto: sin estas variables el panel no deja entrar.
ADMIN_PASSWORD_HASH=
SESSION_SECRET=

# ── Pagos: Stripe (tarjeta; Bizum y PayPal si los activas en Stripe) ──
# Claves sk_test_... = MODO PRUEBA (no se cobra dinero real)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Pagos: PayPal directo (opcional, alternativa a PayPal vía Stripe) ──
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# ── WhatsApp Business Platform (Cloud API oficial de Meta) ────
WHATSAPP_GRAPH_VERSION=v24.0
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Números (formato 34XXXXXXXXX, separados por comas) que reciben el aviso de pedido
WHATSAPP_OWNER_NUMBERS=
# Plantillas aprobadas por Meta (ver docs/INTEGRACIONES.md)
WHATSAPP_TEMPLATE_NEW_ORDER=
WHATSAPP_TEMPLATE_ORDER_STATUS=
WHATSAPP_TEMPLATE_LANG=es
# Números autorizados a enviar fotos/vídeos a la bandeja de borradores
WHATSAPP_INBOX_ALLOWED_NUMBERS=

# ── Mapas y rutas ────────────────────────────────────────────
# Teselas del mapa: "osm" (OpenStreetMap, uso ligero con atribución), "none" o una URL de plantilla
MAP_TILES=osm
# Geocodificación de direcciones: "none" o "nominatim" (envía la dirección a OpenStreetMap)
GEOCODER=none
# Distancias reales por carretera (opcional): clave de openrouteservice.org
ORS_API_KEY=
